---
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Gettext Webview</title>
    <style>
      :root {
        color-scheme: light dark;
      }
      body {
        margin: 0;
        font-family: system-ui, sans-serif;
        display: flex;
        flex-direction: column;
        height: 100vh;
      }
      header {
        padding: 1rem;
        border-bottom: 1px solid #8884;
        display: flex;
        gap: 1rem;
        align-items: center;
        flex-wrap: wrap;
      }
      header h1 {
        font-size: 1.25rem;
        margin: 0;
      }
      #toolbar {
        display: flex;
        gap: 0.5rem;
        align-items: center;
        margin-right: auto;
      }
      #column-name {
        padding: 0.3rem 0.5rem;
        border: 1px solid #8886;
        border-radius: 4px;
        font: inherit;
      }
      #table-wrapper {
        flex: 1;
        overflow: auto;
      }
      table {
        border-collapse: collapse;
        width: 100%;
        font-size: 0.9rem;
      }
      th,
      td {
        border: 1px solid #8884;
        padding: 0.4rem 0.6rem;
        text-align: left;
        vertical-align: top;
        white-space: pre-wrap;
      }
      th {
        position: sticky;
        top: 0;
        background: #2b2b2b;
        color: #fff;
      }
      td:first-child {
        font-family: ui-monospace, monospace;
      }
      td.msgstr {
        padding: 0;
      }
      td.msgstr input {
        width: 100%;
        box-sizing: border-box;
        border: none;
        padding: 0.4rem 0.6rem;
        font: inherit;
        background: transparent;
        color: inherit;
      }
      td.msgstr input:focus {
        outline: 2px solid #4a9;
        outline-offset: -2px;
      }
      td.msgstr input.dirty {
        background: #4a93;
      }
      .empty {
        padding: 2rem;
        text-align: center;
        color: #888;
      }
      .file-chip {
        padding: 0.2rem 0.6rem;
        border: 1px solid #8886;
        border-radius: 999px;
        font-size: 0.8rem;
      }
    </style>
  </head>
  <body>
    <header>
      <h1>Gettext Webview</h1>
      <div id="toolbar">
        <input type="file" id="file-input" accept=".po,.pot" multiple />
        <input
          type="text"
          id="column-name"
          placeholder="Column name"
          aria-label="Column name"
        />
        <button type="button" id="load-button">Load</button>
      </div>
      <div id="loaded-files"></div>
    </header>
    <div id="table-wrapper">
      <div class="empty" id="placeholder">Load one or more .po / .pot files to begin.</div>
      <table id="po-table" hidden>
        <thead>
          <tr>
            <th>msgid</th>
            <th id="lang-a"></th>
            <th id="lang-b"></th>
          </tr>
        </thead>
        <tbody id="table-body"></tbody>
      </table>
    </div>

    <script>
      const fileInput = document.getElementById('file-input');
      const columnName = document.getElementById('column-name');
      const loadButton = document.getElementById('load-button');
      const table = document.getElementById('po-table');
      const tableBody = document.getElementById('table-body');
      const placeholder = document.getElementById('placeholder');
      const langA = document.getElementById('lang-a');
      const langB = document.getElementById('lang-b');
      const loadedFiles = document.getElementById('loaded-files');
      const files = [];

      loadButton.addEventListener('click', async () => {
        const { loadPoFile } = await import('../lib/po.ts');
        const selected = Array.from(fileInput.files);
        if (selected.length === 0) return;
        const label = columnName.value.trim();
        for (const file of selected) {
          try {
            const loaded = await loadPoFile(file);
            if (label) loaded.language = label;
            files.push(loaded);
          } catch (err) {
            console.error(`Failed to parse ${file.name}`, err);
          }
        }
        fileInput.value = '';
        columnName.value = '';
        render();
      });

      fileInput.addEventListener('change', () => {
        if (fileInput.files.length > 0 && !columnName.value.trim()) {
          columnName.value = fileInput.files[0].name.replace(/\.(po|pot)$/i, '');
        }
      });

      function render() {
        const count = files.length;
        table.hidden = count === 0;
        placeholder.hidden = count > 0;
        loadedFiles.innerHTML = '';
        for (const file of files) {
          const chip = document.createElement('span');
          chip.className = 'file-chip';
          chip.textContent = `${file.name} (${file.entries.length} entries)`;
          loadedFiles.appendChild(chip);
        }
        if (count === 0) return;
        langA.textContent = files[0].language;
        langB.textContent = files[1] ? files[1].language : '—';

        const msgids = [...new Set(files.flatMap((f) => f.entries.map((e) => e.msgid)))];
        const rows = document.createDocumentFragment();
        for (const msgid of msgids) {
          const tr = document.createElement('tr');

          const msgidCell = document.createElement('td');
          msgidCell.textContent = msgid;
          tr.appendChild(msgidCell);

          for (const file of [files[0], files[1]]) {
            const td = document.createElement('td');
            td.className = 'msgstr';
            const entry = file?.entries.find((e) => e.msgid === msgid);
            if (entry) {
              const input = document.createElement('input');
              input.type = 'text';
              input.value = entry.msgstr;
              input.setAttribute('aria-label', `msgstr for "${msgid}"`);
              input.addEventListener('input', () => {
                entry.msgstr = input.value;
                input.classList.add('dirty');
              });
              td.appendChild(input);
            } else {
              td.textContent = '';
            }
            tr.appendChild(td);
          }
          rows.appendChild(tr);
        }
        tableBody.replaceChildren(rows);
      }
    </script>
  </body>
</html>
