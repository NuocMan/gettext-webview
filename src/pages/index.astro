---
import '../styles/global.css';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Gettext Webview</title>
  </head>
  <body>
    <header>
      <h1>Gettext Webview</h1>
      <button type="button" id="theme-toggle" aria-label="Toggle light or dark theme">🌙</button>
    </header>
    <div id="table-wrapper">
      <table id="po-table">
        <colgroup>
          <col style="width: 15%" />
          <col style="width: 35%" />
          <col style="width: 35%" />
        </colgroup>
        <thead>
          <tr>
            <th>msgid</th>
            <th id="lang-a"></th>
            <th id="lang-b"></th>
          </tr>
        </thead>
        <tbody id="table-body"></tbody>
      </table>
      <div class="empty" id="placeholder" hidden>Load a .po / .pot file into a column to begin.</div>
      <input type="file" id="file-input" accept=".po,.pot" hidden />
    </div>

    <script src="../scripts/app.ts"></script>
  </body>
</html>
